+func modelConfigSummary(cfg map[string]any) map[string]any {
+	models, _ := cfg["model_list"].([]any)
+	defaultModel, _ := cfg["model_name"].(string)
+	outModels := make([]map[string]any, 0, len(models))
+	enabled := 0
+	for _, item := range models {
+		m, ok := item.(map[string]any)
+		if !ok {
+			continue
+		}
+		name, _ := m["model_name"].(string)
+		model, _ := m["model"].(string)
+		provider, _ := m["provider"].(string)
+		if provider == "" {
+			provider = strings.SplitN(model, "/", 2)[0]
+		}
+		isEnabled := boolFromAny(m["enabled"], true)
+		if isEnabled {
+			enabled++
+		}
+		outModels = append(outModels, map[string]any{
+			"model_name":      name,
+			"provider":        provider,
+			"model":           model,
+			"enabled":         isEnabled,
+			"is_default":      name != "" && name == defaultModel,
+			"has_api_base":    strings.TrimSpace(stringFromAny(m["api_base"])) != "",
+			"has_api_key_ref": strings.TrimSpace(stringFromAny(m["api_key"])) != "",
+		})
+	}
+	return map[string]any{
+		"default_model": defaultModel,
+		"total":         len(outModels),
+		"enabled":       enabled,
+		"models":        outModels,
+	}
+}
