# Environment for an off-board nora host. Copy to /opt/nora/nora.env and edit.
# Nothing here is a secret; credentials belong in a file the service reads with
# its own permissions, never in a task or a skill parameter.

# Force the hardware gate. Unset lets the executor probe the host for a camera,
# I2C bus, GPIO chip, or capture device and decide.
#   1 = hardware skills run (devices are passed through)
#   0 = hardware skills are skipped with a stated reason
NORA_HARDWARE=0

# Where the research engine keeps questions, findings, and watches.
NORA_STATE_DIR=/opt/nora/state

# Where monitor journals land. On a board these are written by sensor tasks; on
# a cloud host, point this at whatever drops JSONL there — an uploader, a cron
# fetch, a mounted volume.
NORA_JOURNAL_DIRS=/opt/nora/monitors

# The evidence journal the executor and the research engine share.
NORA_EVIDENCE_JOURNAL=/opt/nora/state/experiments.jsonl

# Optional: a domain application checkout, if this host runs one.
# GOIDANICH_REPO=/opt/nora/apps/goidanich
