+func configWorkspace(cfg map[string]any, fallback string) string {
+	if agent, ok := cfg["agent"].(map[string]any); ok {
+		if workspace, ok := agent["workspace"].(string); ok && strings.TrimSpace(workspace) != "" {
+			return workspace
+		}
+		if defaults, ok := agent["defaults"].(map[string]any); ok {
+			if workspace, ok := defaults["workspace"].(string); ok && strings.TrimSpace(workspace) != "" {
+				return workspace
+			}
+		}
+	}
+	if defaults, ok := cfg["defaults"].(map[string]any); ok {
+		if workspace, ok := defaults["workspace"].(string); ok && strings.TrimSpace(workspace) != "" {
+			return workspace
+		}
+	}
+	return fallback
+}
