# nora off-board image.
#
# The executor is a static Go binary, but the skills it runs are Python
# scripts, so the runtime carries an interpreter rather than being FROM
# scratch. Nothing else is installed: the research engine uses the standard
# library only.

FROM docker.io/library/golang:1.21-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY main.go ./
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -o /out/nora main.go

FROM docker.io/library/python:3.12-alpine
RUN adduser -S -H -h /opt/nora nora
WORKDIR /opt/nora
COPY --from=build /out/nora /opt/nora/nora

# Copy only what an off-board host can use. Add your domain pack and adapter
# here; leave the camera, NPU and I2C skills on the board.
COPY skills/research_agent  /opt/nora/skills/research_agent
COPY skills/monitor_summary /opt/nora/skills/monitor_summary
COPY skills/validate_skill  /opt/nora/skills/validate_skill
COPY tasks/029_autonomous_research_cycle.yaml /opt/nora/tasks/

RUN mkdir -p /opt/nora/state /opt/nora/monitors && chown -R nora /opt/nora
USER nora

# No inbound ports: the engine reads local evidence and writes local findings.
ENV NORA_HARDWARE=0
ENTRYPOINT ["/opt/nora/nora"]
