+func collectGatewayOverview(ctx context.Context, configPath string, cfg map[string]any, workspace string) map[string]any {
+	cronPath := filepath.Join(workspace, "cron", "jobs.json")
+	skillsDir := filepath.Join(workspace, "skills")
+	picoclawHome := filepath.Dir(configPath)
+	return map[string]any{
+		"model_config": modelConfigSummary(cfg),
+		"channels": map[string]any{
+			"configured": configuredChannels(cfg),
+			"active":     activeChannelsFromLog(defaultGatewayLogPath),
+		},
+		"telegram": telegramSummary(picoclawHome, workspace, cfg),
+		"skills_tools": map[string]any{
+			"skills_path": skillsDir,
+			"skills":      skillInventory(skillsDir),
+			"tools":       toolInventory(cfg),
+		},
+		"scheduler": cronSummary(cronPath),
+		"logs_health": map[string]any{
+			"ready":  httpJSON(ctx, defaultGatewayReadyURL),
+			"health": httpJSON(ctx, defaultGatewayHealthURL),
+			"log":    fileMeta(defaultGatewayLogPath),
+			"tail":   tailLines(defaultGatewayLogPath, 18),
+		},
+		"config": fileMeta(configPath),
+	}
+}
