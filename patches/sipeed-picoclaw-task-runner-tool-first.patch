+func skillInventory(dir string) map[string]any {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return map[string]any{"path": dir, "available": false, "error": err.Error(), "items": []any{}}
+	}
+	items := make([]map[string]any, 0, len(entries))
+	for _, entry := range entries {
+		if !entry.IsDir() {
+			continue
+		}
+		skillPath := filepath.Join(dir, entry.Name())
+		name := skillNameFromMarkdown(filepath.Join(skillPath, "SKILL.md"))
+		items = append(items, map[string]any{
+			"directory": entry.Name(),
+			"name":      firstNonEmpty(name, entry.Name()),
+			"path":      skillPath,
+		})
+	}
+	sort.Slice(items, func(i, j int) bool { return stringFromAny(items[i]["name"]) < stringFromAny(items[j]["name"]) })
+	return map[string]any{"path": dir, "available": true, "count": len(items), "items": items}
+}
