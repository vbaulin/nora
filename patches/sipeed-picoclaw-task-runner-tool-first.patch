+func thermalZones() []map[string]any {
+	matches, _ := filepath.Glob("/sys/class/thermal/thermal_zone*/temp")
+	out := make([]map[string]any, 0, len(matches))
+	for _, match := range matches {
+		raw, err := os.ReadFile(match)
+		item := fileMeta(match)
+		if err == nil {
+			if milli, parseErr := strconv.ParseFloat(strings.TrimSpace(string(raw)), 64); parseErr == nil {
+				item["celsius"] = milli / 1000.0
+			}
+		}
+		out = append(out, item)
+	}
+	return out
+}
