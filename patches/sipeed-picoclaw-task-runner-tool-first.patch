+func taskQueueSummary(dirs []string) map[string]any {
+	type taskItem struct {
+		Path   string `json:"path"`
+		Status string `json:"status,omitempty"`
+		Name   string `json:"name,omitempty"`
+	}
+	var items []taskItem
+	statusCounts := map[string]int{}
+	for _, dir := range dirs {
+		_ = filepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {
+			if err != nil || d == nil || d.IsDir() {
+				return nil
+			}
+			if !strings.HasSuffix(path, ".yaml") && !strings.HasSuffix(path, ".yml") {
+				return nil
+			}
+			raw, err := os.ReadFile(path)
+			if err != nil {
+				return nil
+			}
+			status := yamlScalar(raw, "status")
+			name := yamlScalar(raw, "name")
+			if status != "" {
+				statusCounts[status]++
+			}
+			items = append(items, taskItem{Path: path, Status: status, Name: name})
+			return nil
+		})
+	}
+	sort.Slice(items, func(i, j int) bool { return items[i].Path < items[j].Path })
+	return map[string]any{"directories": dirs, "count": len(items), "status_counts": statusCounts, "items": items}
+}
+
+func taskKeywordHits(dirs []string, keywords []string) []map[string]any {
+	var hits []map[string]any
+	for _, dir := range dirs {
+		_ = filepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {
+			if err != nil || d == nil || d.IsDir() {
+				return nil
+			}
+			if !strings.HasSuffix(path, ".yaml") && !strings.HasSuffix(path, ".yml") && !strings.HasSuffix(path, ".md") {
+				return nil
+			}
+			raw, err := os.ReadFile(path)
+			if err != nil {
+				return nil
+			}
+			lower := strings.ToLower(string(raw))
+			var matched []string
+			for _, keyword := range keywords {
+				if strings.Contains(lower, strings.ToLower(keyword)) {
+					matched = append(matched, keyword)
+				}
+			}
+			if len(matched) > 0 {
+				hits = append(hits, map[string]any{"path": path, "keywords": matched})
+			}
+			return nil
+		})
+	}
+	sort.Slice(hits, func(i, j int) bool { return stringFromAny(hits[i]["path"]) < stringFromAny(hits[j]["path"]) })
+	return hits
+}
