diff --git a/pkg/agent/vineyard_structured_delivery.go b/pkg/agent/vineyard_structured_delivery.go
new file mode 100644
index 00000000..1ff21615
--- /dev/null
+++ b/pkg/agent/vineyard_structured_delivery.go
@@ -0,0 +1,454 @@
+// PicoClaw - Ultra-lightweight personal AI agent
+
+package agent
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/sipeed/picoclaw/pkg/bus"
+	"github.com/sipeed/picoclaw/pkg/constants"
+	"github.com/sipeed/picoclaw/pkg/logger"
+	"github.com/sipeed/picoclaw/pkg/media"
+)
+
+type structuredTelegramPayload struct {
+	SendText        string                 `json:"send_text"`
+	Message         string                 `json:"message"`
+	SendPhotoPath   string                 `json:"send_photo_path"`
+	SendImagePath   string                 `json:"send_image_path"`
+	PhotoPath       string                 `json:"photo_path"`
+	ImagePath       string                 `json:"image_path"`
+	AttachmentPath  string                 `json:"attachment_path"`
+	MustSendExactly bool                   `json:"must_send_exactly"`
+	MustAttachImage bool                   `json:"must_attach_image"`
+	Telegram        map[string]any         `json:"telegram"`
+	Attachments     []structuredAttachment `json:"attachments"`
+	Media           []structuredAttachment `json:"media"`
+}
+
+type structuredAttachment struct {
+	Type       string `json:"type"`
+	Path       string `json:"path"`
+	SourcePath string `json:"source_path"`
+	Caption    string `json:"caption"`
+	MimeType   string `json:"mime_type"`
+	Exists     bool   `json:"exists"`
+	Disease    string `json:"disease"`
+}
+
+func (al *AgentLoop) publishStructuredResponseIfNeeded(ctx context.Context, channel, chatID, sessionKey, response string) bool {
+	payload, ok := parseStructuredTelegramPayload(response)
+	if !ok {
+		return false
+	}
+
+	text := payload.SendText
+	if text == "" {
+		if v, _ := payload.Telegram["text_after_photo"].(string); v != "" {
+			text = v
+		} else if payload.Message != "" {
+			text = payload.Message
+		}
+	}
+
+	parts := al.structuredPayloadMediaParts(payload)
+	if len(parts) > 0 {
+		outbound := bus.OutboundMediaMessage{
+			Channel:    channel,
+			ChatID:     chatID,
+			Context:    bus.NewOutboundContext(channel, chatID, ""),
+			SessionKey: sessionKey,
+			Parts:      parts,
+		}
+		if al.channelManager != nil && channel != "" && !constants.IsInternalChannel(channel) {
+			if err := al.channelManager.SendMedia(ctx, outbound); err != nil {
+				logger.WarnCF("agent", "Failed to send structured media payload", map[string]any{
+					"channel": channel,
+					"chat_id": chatID,
+					"error":   err.Error(),
+				})
+			}
+		} else if al.bus != nil {
+			_ = al.bus.PublishOutboundMedia(ctx, outbound)
+		}
+	}
+
+	if text != "" {
+		msg := bus.OutboundMessage{
+			Context:    bus.NewOutboundContext(channel, chatID, ""),
+			SessionKey: sessionKey,
+			Content:    text,
+		}
+		markFinalOutbound(&msg)
+		_ = al.bus.PublishOutbound(ctx, msg)
+	}
+
+	logger.InfoCF("agent", "Published structured Telegram payload", map[string]any{
+		"channel":     channel,
+		"chat_id":     chatID,
+		"media_parts": len(parts),
+		"text_len":    len(text),
+	})
+	return true
+}
+
+func parseStructuredTelegramPayload(response string) (structuredTelegramPayload, bool) {
+	for _, candidate := range jsonCandidates(response) {
+		var payload structuredTelegramPayload
+		if err := json.Unmarshal([]byte(candidate), &payload); err != nil {
+			continue
+		}
+		if payload.MustSendExactly || payload.MustAttachImage || payload.SendText != "" ||
+			payload.SendPhotoPath != "" || payload.SendImagePath != "" || payload.PhotoPath != "" ||
+			payload.ImagePath != "" || len(payload.Attachments) > 0 || len(payload.Media) > 0 ||
+			len(payload.Telegram) > 0 {
+			return payload, true
+		}
+	}
+	return structuredTelegramPayload{}, false
+}
+
+func jsonCandidates(response string) []string {
+	response = strings.TrimSpace(response)
+	candidates := []string{response}
+	if strings.Contains(response, "```") {
+		parts := strings.Split(response, "```")
+		for _, part := range parts {
+			part = strings.TrimSpace(part)
+			part = strings.TrimPrefix(part, "json")
+			part = strings.TrimSpace(part)
+			if strings.HasPrefix(part, "{") {
+				candidates = append(candidates, part)
+			}
+		}
+	}
+	start := strings.Index(response, "{")
+	end := strings.LastIndex(response, "}")
+	if start >= 0 && end > start {
+		candidates = append(candidates, response[start:end+1])
+	}
+	return candidates
+}
+
+func (al *AgentLoop) structuredPayloadMediaParts(payload structuredTelegramPayload) []bus.MediaPart {
+	var attachments []structuredAttachment
+	if len(payload.Media) > 0 {
+		attachments = payload.Media
+	} else if len(payload.Attachments) > 0 {
+		attachments = payload.Attachments
+	}
+	if len(attachments) == 0 {
+		path := firstNonEmpty(payload.SendPhotoPath, payload.SendImagePath, payload.PhotoPath, payload.ImagePath, payload.AttachmentPath)
+		if path == "" {
+			if v, _ := payload.Telegram["photo"].(string); v != "" {
+				path = v
+			}
+		}
+		if path != "" {
+			attachments = []structuredAttachment{{Type: "photo", Path: path}}
+		}
+	}
+	if al.mediaStore == nil {
+		return nil
+	}
+	parts := make([]bus.MediaPart, 0, len(attachments))
+	for _, attachment := range attachments {
+		path := firstNonEmpty(attachment.Path, attachment.SourcePath)
+		if path == "" {
+			continue
+		}
+		if _, err := os.Stat(path); err != nil {
+			logger.WarnCF("agent", "Structured media path does not exist", map[string]any{
+				"path":  path,
+				"error": err.Error(),
+			})
+			continue
+		}
+		contentType := attachment.MimeType
+		if contentType == "" {
+			contentType = "image/png"
+		}
+		ref, err := al.mediaStore.Store(path, media.MediaMeta{
+			Filename:      filepath.Base(path),
+			ContentType:   contentType,
+			Source:        "structured-skill-payload",
+			CleanupPolicy: media.CleanupPolicyForgetOnly,
+		}, "structured-telegram")
+		if err != nil {
+			logger.WarnCF("agent", "Failed to register structured media path", map[string]any{
+				"path":  path,
+				"error": err.Error(),
+			})
+			continue
+		}
+		parts = append(parts, bus.MediaPart{
+			Type:        mediaPartType(attachment.Type, contentType, path),
+			Ref:         ref,
+			Caption:     attachment.Caption,
+			Filename:    filepath.Base(path),
+			ContentType: contentType,
+		})
+	}
+	return parts
+}
+
+func mediaPartType(kind, contentType, path string) string {
+	kind = strings.ToLower(strings.TrimSpace(kind))
+	contentType = strings.ToLower(strings.TrimSpace(contentType))
+	switch {
+	case kind == "photo" || kind == "image" || strings.HasPrefix(contentType, "image/"):
+		return "image"
+	case strings.HasPrefix(contentType, "audio/"):
+		return "audio"
+	case strings.HasPrefix(contentType, "video/"):
+		return "video"
+	default:
+		ext := strings.ToLower(filepath.Ext(path))
+		if ext == ".png" || ext == ".jpg" || ext == ".jpeg" || ext == ".webp" {
+			return "image"
+		}
+		return "file"
+	}
+}
+
+func firstNonEmpty(values ...string) string {
+	for _, value := range values {
+		if strings.TrimSpace(value) != "" {
+			return strings.TrimSpace(value)
+		}
+	}
+	return ""
+}
+
+func (al *AgentLoop) handleDirectVineyardReportRoute(ctx context.Context, msg bus.InboundMessage, sessionKey string) (bool, error) {
+	if isTreatmentAdviceRequest(strings.ToLower(msg.Content)) {
+		return false, nil
+	}
+	skill, _, ok := forcedVineyardSkillRoute(msg.Channel, msg.Content)
+	if !ok || skill != "daily-vineyard-briefing" {
+		return false, nil
+	}
+
+	response, err := runVineyardBriefingSkill(ctx)
+	if err != nil {
+		logger.WarnCF("agent", "Direct vineyard report route failed",
+			map[string]any{
+				"channel": msg.Channel,
+				"chat_id": msg.ChatID,
+				"error":   err.Error(),
+			})
+		al.PublishResponseIfNeeded(ctx, msg.Channel, msg.ChatID, sessionKey,
+			fmt.Sprintf("Could not generate the vineyard plots from the board: %v", err))
+		return true, nil
+	}
+
+	if !al.publishStructuredResponseIfNeeded(ctx, msg.Channel, msg.ChatID, sessionKey, response) {
+		logger.WarnCF("agent", "Direct vineyard report returned unstructured output",
+			map[string]any{
+				"channel":      msg.Channel,
+				"chat_id":      msg.ChatID,
+				"output_bytes": len(response),
+			})
+		al.PublishResponseIfNeeded(ctx, msg.Channel, msg.ChatID, sessionKey,
+			"The vineyard report ran, but the gateway could not parse the plot payload.")
+	}
+
+	logger.InfoCF("agent", "Handled vineyard report directly",
+		map[string]any{
+			"channel": msg.Channel,
+			"chat_id": msg.ChatID,
+		})
+	return true, nil
+}
+
+func runVineyardBriefingSkill(ctx context.Context) (string, error) {
+	payload := map[string]any{
+		"mode":       "both_disease_report",
+		"repo_path":  "/root/.picoclaw/workspace/goidanich",
+		"days":       31,
+		"notify":     false,
+		"board_only": true,
+		"channel":    "picoclaw_telegram",
+	}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return "", err
+	}
+
+	path := vineyardBriefingSkillPath()
+	runCtx, cancel := context.WithTimeout(ctx, 6*time.Minute)
+	defer cancel()
+	cmd := exec.CommandContext(runCtx, path)
+	cmd.Stdin = bytes.NewReader(body)
+	cmd.Dir = filepath.Dir(path)
+	output, err := cmd.CombinedOutput()
+	if runCtx.Err() == context.DeadlineExceeded {
+		return "", fmt.Errorf("daily-vineyard-briefing timed out after 6 minutes")
+	}
+	if err != nil {
+		detail := strings.TrimSpace(string(output))
+		if detail == "" {
+			detail = err.Error()
+		}
+		return "", fmt.Errorf("%s", detail)
+	}
+	return string(output), nil
+}
+
+func vineyardBriefingSkillPath() string {
+	if path := strings.TrimSpace(os.Getenv("PICOCLAW_VINEYARD_BRIEFING_RUN")); path != "" {
+		return path
+	}
+	for _, path := range []string{
+		"/root/nano-os-agent/skills/daily_vineyard_briefing/run.py",
+		"/root/.picoclaw/workspace/skills/daily_vineyard_briefing/run.py",
+		"/root/nano-os-agent/skills/daily-vineyard-briefing.sh",
+	} {
+		if stat, err := os.Stat(path); err == nil && !stat.IsDir() {
+			return path
+		}
+	}
+	return "/root/nano-os-agent/skills/daily_vineyard_briefing/run.py"
+}
+
+func forcedVineyardSkillRoute(channel, text string) (string, string, bool) {
+	normalizedChannel := strings.ToLower(strings.TrimSpace(channel))
+	if normalizedChannel != "telegram" && normalizedChannel != "pico" {
+		return "", "", false
+	}
+
+	lower := strings.ToLower(text)
+	if isTreatmentAdviceRequest(lower) {
+		return "daily-vineyard-briefing", forceTreatmentAdvicePrompt(text), true
+	}
+	if hasAnyMarker(lower, []string{
+		"spray", "sprayed", "applied", "treated", "treatment", "tractament",
+		"tractat", "aplicat", "sulfat", "pulveritzat", "product", "dose",
+		"lot", "water volume", "clean inspection", "false alarm", "grade",
+		"grau", "grado", "detected", "not inspected",
+	}) {
+		return "farmer-feedback-capture", forceFarmerFeedbackPrompt(text), true
+	}
+	if hasAnyMarker(lower, []string{
+		"risc", "risk", "mildew", "downy", "powdery", "mildiu", "oidi", "oïdi",
+		"pmi", "rossi", "plot", "plots", "graph", "chart", "grafica", "gràfica",
+		"grafic", "gràfic", "grafico", "gráfico", "image", "imatge", "imagen",
+		"forecast", "goidanich", "avgvstvs",
+	}) {
+		return "daily-vineyard-briefing", forceVineyardReportPrompt(text), true
+	}
+	if hasAnyMarker(lower, []string{
+		"vineyard", "goidanich", "avgvstvs", "mildew", "downy", "powdery",
+		"mildiu", "oidi", "oïdi", "temps", "weather", "camera", "photo",
+	}) {
+		return "", forceGeneralSkillFirstPrompt(text), true
+	}
+	return "", "", false
+}
+
+func isTreatmentAdviceRequest(lower string) bool {
+	if !hasAnyMarker(lower, []string{
+		"product", "treatment", "spray", "apply", "aplicar", "tractar",
+		"tratamiento", "tractament", "sulfate", "sulfur", "sulphur", "copper",
+		"sofre", "azufre", "coure", "cobre",
+	}) {
+		return false
+	}
+	return hasAnyMarker(lower, []string{
+		"what", "which", "should", "need", "recommend", "advice", "advise",
+		"que ", "qué ", "quin", "quina", "cuál", "cual", "debo", "hauria",
+		"haig", "cal ", "convé", "recoman", "recomienda", "?",
+	})
+}
+
+func hasAnyMarker(text string, markers []string) bool {
+	for _, marker := range markers {
+		if strings.Contains(text, marker) {
+			return true
+		}
+	}
+	return false
+}
+
+func appendMissingSkill(skills []string, skill string) []string {
+	for _, existing := range skills {
+		if strings.EqualFold(existing, skill) {
+			return skills
+		}
+	}
+	return append(skills, skill)
+}
+
+func forceVineyardReportPrompt(raw string) string {
+	return "This is a vineyard/Goidanich board request. Do not answer from session memory. " +
+		"First call skill daily-vineyard-briefing with " +
+		"{\"mode\":\"both_disease_report\",\"days\":31,\"notify\":false,\"board_only\":true,\"channel\":\"picoclaw_telegram\"}. " +
+		"If today's dashboard_state, dashboard_report, and PNG plots are fresh, use those cached files from disk; regenerate only if missing or stale. " +
+		"The gateway should deliver the skill payload directly: send_text plus all attachments/media. Do not paste raw JSON, history rows, or image paths to the farmer. " +
+		"If a final response is still needed, use only the top-level send_text from the current skill result. Do not summarize from memory. " +
+		"User request: " + raw
+}
+
+func forceFarmerFeedbackPrompt(raw string) string {
+	return "This is a farmer feedback/treatment message. Do not answer from memory and do not write directly. " +
+		"First call skill farmer-feedback-capture with " +
+		"{\"raw_text\":\"<the farmer message>\",\"confirmed\":false}. " +
+		"Use the returned draft, missing fields, and confirmation_question to ask the farmer to confirm/correct in the same language. " +
+		"Only after explicit confirmation call farmer-feedback-capture again with confirmed=true. " +
+		"Preserve every product, product number, lot, quantity, water volume, treated area, method, target, and per-hectare normalized quantity. " +
+		"User request: " + raw
+}
+
+func forceTreatmentAdvicePrompt(raw string) string {
+	return "This is a vineyard treatment-advice request. Do not answer from memory. " +
+		"First call skill daily-vineyard-briefing with " +
+		"{\"mode\":\"both_disease_report\",\"days\":31,\"notify\":false,\"board_only\":true,\"channel\":\"picoclaw_telegram\"} " +
+		"to inspect current disease signals, forecast, last treatment history, and product/catalog state. " +
+		"Then answer in the farmer's language with one concise human message: current risk, treatment outlook, whether treatment is needed now or only scouting/protection check, and what information is missing. " +
+		"Do not send the full report or plots unless the user explicitly asked for plots/full report. " +
+		"If the farmer names a product or code, use farmer-feedback-capture with confirmed=false to validate product/catalog identity before recording. " +
+		"Never invent products, doses, or risk values. User request: " + raw
+}
+
+func forceGeneralSkillFirstPrompt(raw string) string {
+	return "This is a board/vineyard/hardware request. Do not answer from session memory. " +
+		"First inspect available skills/tools and nano-os-agent tasks, choose the matching nano-os-agent or PicoClaw skill/tool/task, call it, " +
+		"and answer only from returned structured data, local YAML/config, current task state, or current dashboard files. If media or attachments are returned, preserve them. " +
+		"User request: " + raw
+}
+
+func looksLikeStaleVineyardSummary(response string) bool {
+	lower := strings.ToLower(response)
+	if !strings.Contains(lower, "vineyard") && !strings.Contains(lower, "goidanich") &&
+		!strings.Contains(lower, "downy") && !strings.Contains(lower, "powdery") &&
+		!strings.Contains(lower, "mildew") && !strings.Contains(lower, "oidi") {
+		return false
+	}
+	for _, marker := range []string{
+		"the risk today is low",
+		"risk today: 15.0%",
+		"general personalized risk",
+		"generic personalized risk",
+		"powdery mildew: the general personalized risk",
+		"refer to the specific powdery risk indicators",
+		"please remember to monitor the specific powdery risk indicators",
+		"historically been higher",
+		"overall, the current risk for both diseases is low",
+		"overall, the disease pressure is currently low",
+	} {
+		if strings.Contains(lower, marker) {
+			return true
+		}
+	}
+	return strings.Contains(lower, "powdery") &&
+		strings.Contains(lower, "15.0%") &&
+		strings.Contains(lower, "personalized")
+}
