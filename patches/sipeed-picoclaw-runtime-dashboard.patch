+func skillInventory(dir string) map[string]any {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return map[string]any{"path": dir, "available": false, "error": err.Error(), "items": []any{}}
+	}
+	items := make([]map[string]any, 0, len(entries))
+	for _, entry := range entries {
+		if !entry.IsDir() {
+			continue
+		}
+		skillPath := filepath.Join(dir, entry.Name())
+		name := skillNameFromMarkdown(filepath.Join(skillPath, "SKILL.md"))
+		items = append(items, map[string]any{
+			"directory": entry.Name(),
+			"name":      firstNonEmpty(name, entry.Name()),
+			"path":      skillPath,
+		})
+	}
+	sort.Slice(items, func(i, j int) bool { return stringFromAny(items[i]["name"]) < stringFromAny(items[j]["name"]) })
+	return map[string]any{"path": dir, "available": true, "count": len(items), "items": items}
+}
+
+func skillNameFromMarkdown(path string) string {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return ""
+	}
+	scanner := bufio.NewScanner(bytes.NewReader(raw))
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if strings.HasPrefix(line, "name:") {
+			return strings.Trim(strings.TrimSpace(strings.TrimPrefix(line, "name:")), `"'`)
+		}
+	}
+	return ""
+}
+
+func toolInventory(cfg map[string]any) map[string]any {
+	tools, ok := cfg["tools"].(map[string]any)
+	if !ok {
+		return map[string]any{"count": 0, "items": []string{}}
+	}
+	items := make([]string, 0, len(tools))
+	for key := range tools {
+		items = append(items, key)
+	}
+	sort.Strings(items)
+	return map[string]any{"count": len(items), "items": items}
+}
+
+func cronSummary(path string) map[string]any {
+	data := readJSONMap(path)
+	jobsRaw, _ := data["jobs"].([]any)
+	jobs := make([]map[string]any, 0, len(jobsRaw))
+	enabled := 0
+	for _, item := range jobsRaw {
+		m, ok := item.(map[string]any)
+		if !ok {
+			continue
+		}
+		isEnabled := boolFromAny(m["enabled"], false)
+		if isEnabled {
+			enabled++
+		}
+		jobs = append(jobs, map[string]any{
+			"id":       stringFromAny(m["id"]),
+			"name":     stringFromAny(m["name"]),
+			"enabled":  isEnabled,
+			"schedule": m["schedule"],
+			"state":    m["state"],
+		})
+	}
+	return map[string]any{
+		"file":    fileMeta(path),
+		"count":   len(jobs),
+		"enabled": enabled,
+		"jobs":    jobs,
+	}
+}
