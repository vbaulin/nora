+      <span className="max-w-[68%] text-right font-medium break-words">
+        {asString(value)}
+      </span>
+    </div>
+  )
+}
+
+function ExecutorCard({ executor }: { executor: RuntimeMap }) {
+  const binary = asMap(executor.binary)
+  const processes = asArray(executor.processes)
+  return (
+    <Card size="sm" className="rounded-lg">
+      <CardHeader>
+        <div className="flex items-start justify-between gap-3">
+          <div>
+            <CardTitle>nano-os-agent executor</CardTitle>
+            <CardDescription>
+              One-shot task execution uses the local board binary.
+            </CardDescription>
+          </div>
+          <StatusBadge
+            ok={asBool(executor.runnable)}
+            label={asBool(executor.runnable) ? "runnable" : "not runnable"}
+          />
+        </div>
+      </CardHeader>
+      <CardContent className="space-y-2 text-sm">
+        <StatLine label="Binary" value={binary.path} />
+        <StatLine label="Format" value={executor.format} />
+        <StatLine label="Size" value={binary.size} />
+        <StatLine label="Running processes" value={processes.length} />
+      </CardContent>
+    </Card>
+  )
+}
+
+function TaskRow({
+  task,
+  runnable,
+  onRun,
+  running,
+}: {
+  task: RuntimeMap
+  runnable: boolean
+  onRun: (path: string) => void
+  running: boolean
+}) {
+  const path = asString(task.path, "")
+  const actions = asArray(task.actions).map((x) => asString(x, ""))
+  const skills = asArray(task.skill_names).map((x) => asString(x, ""))
+  const safe = asBool(task.safe_to_run)
