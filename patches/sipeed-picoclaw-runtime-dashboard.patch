+func readJSONMap(path string) map[string]any {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return map[string]any{"error": err.Error()}
+	}
+	var out map[string]any
+	if err := json.Unmarshal(raw, &out); err != nil {
+		return map[string]any{"error": err.Error()}
+	}
+	return out
+}
