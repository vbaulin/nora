+func globMetas(pattern string) []map[string]any {
+	matches, _ := filepath.Glob(pattern)
+	out := make([]map[string]any, 0, len(matches))
+	for _, match := range matches {
+		out = append(out, fileMeta(match))
+	}
+	sort.Slice(out, func(i, j int) bool { return stringFromAny(out[i]["path"]) < stringFromAny(out[j]["path"]) })
+	return out
