+		"powdery_mildew": forecastDiseaseCache(filepath.Join(resultsDir, "dashboard_state_powdery_mildew.json")),
+	}
+}
+
+func forecastDiseaseCache(path string) map[string]any {
+	state := readJSONMap(path)
+	rows := 0
+	if forecast, ok := state["forecast"].([]any); ok {
+		rows = len(forecast)
+	}
+	return map[string]any{
+		"state":              fileMeta(path),
+		"updated_at":         state["updated_at"],
+		"forecast_rows":      rows,
+		"forecast_refresh":   state["forecast_refresh"],
+		"freshness":          firstNonNil(state["model_layer_freshness"], state["freshness"]),
+		"forecast_line_rows": lenArray(state["forecast_line_predictions"]),
+	}
+}
+
+func envKeySummary(path string, keys []string) map[string]any {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return map[string]any{"file": fileMeta(path), "keys": map[string]bool{}, "error": err.Error()}
+	}
+	values := map[string]bool{}
+	lines := strings.Split(string(raw), "\n")
+	for _, key := range keys {
+		values[key] = false
+		prefix := key + "="
+		for _, line := range lines {
+			if strings.HasPrefix(strings.TrimSpace(line), prefix) && strings.TrimSpace(strings.TrimPrefix(strings.TrimSpace(line), prefix)) != "" {
+				values[key] = true
+				break
+			}
+		}
+	}
+	return map[string]any{"file": fileMeta(path), "keys": values}
+}
+
+func neighboursSummary(path string) map[string]any {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return map[string]any{"file": fileMeta(path), "count": 0, "error": err.Error()}
+	}
+	count := 0
+	for _, line := range strings.Split(string(raw), "\n") {
+		if strings.HasPrefix(strings.TrimSpace(line), "- ") {
+			count++
+		}
+	}
+	return map[string]any{"file": fileMeta(path), "count": count}
+}
+
+func directorySummary(path string) map[string]any {
+	entries, err := os.ReadDir(path)
+	if err != nil {
+		return map[string]any{"path": path, "exists": false, "count": 0, "error": err.Error(), "recent": []map[string]any{}}
+	}
+	recent := make([]map[string]any, 0, len(entries))
+	for _, entry := range entries {
+		if entry.IsDir() {
+			continue
+		}
+		recent = append(recent, fileMeta(filepath.Join(path, entry.Name())))
+	}
+	sort.Slice(recent, func(i, j int) bool {
+		return floatFromAny(recent[i]["mtime_unix"]) > floatFromAny(recent[j]["mtime_unix"])
+	})
+	if len(recent) > 10 {
+		recent = recent[:10]
+	}
+	return map[string]any{"path": path, "exists": true, "count": len(entries), "recent": recent}
+}
+
+func logLinesContaining(path string, terms []string, limit int) []string {
+	lines := tailLines(path, 300)
+	var matches []string
+	for _, line := range lines {
+		lower := strings.ToLower(line)
+		for _, term := range terms {
+			if strings.Contains(lower, strings.ToLower(term)) {
+				matches = append(matches, line)
+				break
+			}
+		}
+	}
+	if len(matches) > limit {
+		return matches[len(matches)-limit:]
+	}
+	return matches
+}
+
+func sqliteVineyardSummary(ctx context.Context, dbPath string) map[string]any {
+	script := `
+import json, sqlite3, sys
+db=sys.argv[1]
+out={"available": False, "db": db}
+try:
+    con=sqlite3.connect("file:%s?mode=ro" % db, uri=True)
+    cur=con.cursor()
+    tables={r[0] for r in cur.execute("select name from sqlite_master where type='table'")}
+    out["available"]=True
+    out["tables"]=sorted(tables)
+    for table in ("farmer_feedback","feedback_events","product_catalog","products"):
+        if table in tables:
+            try:
+                out[table+"_count"]=cur.execute("select count(*) from "+table).fetchone()[0]
+            except Exception as e:
+                out[table+"_error"]=str(e)
+    con.close()
+except Exception as e:
+    out["error"]=str(e)
+print(json.dumps(out))
+`
+	return runPythonJSON(ctx, script, dbPath)
+}
+
+func treatmentHistorySummary(ctx context.Context, dbPath string) map[string]any {
+	script := `
+import json, sqlite3, sys
+db=sys.argv[1]
+out={"available": False, "db": db, "recent": []}
+try:
+    con=sqlite3.connect("file:%s?mode=ro" % db, uri=True)
+    cur=con.cursor()
+    tables={r[0] for r in cur.execute("select name from sqlite_master where type='table'")}
+    out["available"]=True
+    candidates=["farmer_feedback","feedback_events"]
+    for table in candidates:
+        if table not in tables:
+            continue
+        cols=[r[1] for r in cur.execute("pragma table_info("+table+")")]
+        if "feedback_type" not in cols:
+            continue
+        ts="timestamp" if "timestamp" in cols else ("created_at" if "created_at" in cols else None)
+        field="field_id" if "field_id" in cols else None
+        disease="disease_id" if "disease_id" in cols else None
+        meta="metadata" if "metadata" in cols else ("treatment" if "treatment" in cols else None)
+        select_cols=[c for c in (ts, field, disease, "feedback_type", meta) if c]
+        order = (" order by "+ts+" desc") if ts else ""
+        rows=cur.execute("select "+",".join(select_cols)+" from "+table+" where feedback_type='treatment'"+order+" limit 5").fetchall()
+        for row in rows:
+            item={"table": table}
+            for i,c in enumerate(select_cols):
+                item[c]=row[i]
+            out["recent"].append(item)
+    con.close()
+except Exception as e:
+    out["error"]=str(e)
+print(json.dumps(out))
+`
+	return runPythonJSON(ctx, script, dbPath)
+}
+
+func runPythonJSON(ctx context.Context, script string, arg string) map[string]any {
+	if _, err := os.Stat(arg); err != nil {
+		return map[string]any{"available": false, "db": arg, "error": err.Error()}
+	}
+	cctx, cancel := context.WithTimeout(ctx, 1200*time.Millisecond)
+	defer cancel()
+	cmd := exec.CommandContext(cctx, "python3", "-c", script, arg)
+	out, err := cmd.Output()
+	if err != nil {
+		var exitErr *exec.ExitError
+		if errors.As(err, &exitErr) {
+			return map[string]any{"available": false, "error": err.Error(), "stderr": strings.TrimSpace(string(exitErr.Stderr))}
+		}
+		return map[string]any{"available": false, "error": err.Error()}
+	}
+	var parsed map[string]any
+	if err := json.Unmarshal(out, &parsed); err != nil {
+		return map[string]any{"available": false, "error": err.Error(), "stdout": strings.TrimSpace(string(out))}
+	}
+	return parsed
+}
+
+func fileMeta(path string) map[string]any {
+	info, err := os.Stat(path)
+	if err != nil {
+		return map[string]any{"path": path, "exists": false, "error": err.Error()}
+	}
+	return map[string]any{
+		"path":       path,
+		"exists":     true,
+		"size":       info.Size(),
+		"mtime":      info.ModTime().UTC().Format(time.RFC3339),
+		"mtime_unix": float64(info.ModTime().Unix()),
+		"is_dir":     info.IsDir(),
+	}
+}
+
+func existsMeta(meta map[string]any) bool {
+	return boolFromAny(meta["exists"], false)
+}
+
+func tailLines(path string, n int) []string {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil
+	}
+	lines := strings.Split(strings.TrimRight(string(raw), "\n"), "\n")
+	if len(lines) <= n {
+		return lines
+	}
+	return lines[len(lines)-n:]
+}
+
+func countLines(path string) int {
+	f, err := os.Open(path)
+	if err != nil {
+		return 0
+	}
+	defer f.Close()
+	scanner := bufio.NewScanner(f)
+	count := 0
+	for scanner.Scan() {
+		count++
+	}
+	return count
+}
+
+func yamlScalar(raw []byte, key string) string {
+	scanner := bufio.NewScanner(bytes.NewReader(raw))
+	for scanner.Scan() {
+		k, v, ok := splitYAMLScalar(strings.TrimSpace(scanner.Text()))
+		if ok && k == key {
+			return v
+		}
+	}
+	return ""
+}
+
+func splitYAMLScalar(line string) (string, string, bool) {
+	if line == "" || strings.HasPrefix(line, "#") || !strings.Contains(line, ":") {
+		return "", "", false
+	}
+	parts := strings.SplitN(line, ":", 2)
+	key := strings.TrimSpace(parts[0])
+	value := strings.Trim(strings.TrimSpace(parts[1]), `"'`)
+	if key == "" {
+		return "", "", false
+	}
+	return key, value, true
+}
+
+func keysPresent(m map[string]any, keys []string) map[string]bool {
+	out := make(map[string]bool, len(keys))
+	for _, key := range keys {
+		_, ok := m[key]
+		out[key] = ok
+	}
+	return out
+}
+
+func lenArray(v any) int {
+	if arr, ok := v.([]any); ok {
+		return len(arr)
+	}
+	return 0
+}
+
+func boolFromAny(v any, fallback bool) bool {
+	if b, ok := v.(bool); ok {
+		return b
+	}
+	if s, ok := v.(string); ok {
+		switch strings.ToLower(strings.TrimSpace(s)) {
+		case "true", "yes", "1", "enabled":
+			return true
+		case "false", "no", "0", "disabled":
+			return false
+		}
+	}
+	return fallback
+}
+
+func stringFromAny(v any) string {
+	switch value := v.(type) {
+	case string:
+		return value
+	case json.Number:
+		return value.String()
+	case float64:
+		return strconv.FormatFloat(value, 'f', -1, 64)
+	case int:
+		return strconv.Itoa(value)
+	default:
+		return ""
+	}
+}
+
+func floatFromAny(v any) float64 {
+	switch value := v.(type) {
+	case float64:
+		return value
+	case int64:
+		return float64(value)
+	case int:
+		return float64(value)
+	case string:
+		parsed, _ := strconv.ParseFloat(value, 64)
+		return parsed
+	default:
+		return 0
+	}
+}
+
+func firstNonEmpty(values ...string) string {
+	for _, value := range values {
+		if strings.TrimSpace(value) != "" {
+			return value
+		}
+	}
+	return ""
+}
+
+func firstNonNil(values ...any) any {
+	for _, value := range values {
+		if value != nil {
+			return value
+		}
+	}
+	return nil
+}
+
+func mapJSON(v any) string {
+	raw, err := json.Marshal(v)
+	if err != nil {
+		return ""
+	}
+	return string(raw)
+}
