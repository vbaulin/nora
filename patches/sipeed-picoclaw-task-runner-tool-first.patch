diff --git a/web/backend/api/task_runner.go b/web/backend/api/task_runner.go
new file mode 100644
index 00000000..27c73deb
--- /dev/null
+++ b/web/backend/api/task_runner.go
@@ -0,0 +1,480 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io/fs"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+const (
+	defaultNanoOSAgentBinary = defaultNanoOSAgentRoot + "/nano-os-agent"
+	taskRunnerRoot           = "/tmp/nano-task-runner"
+)
+
+type taskRunnerRunRequest struct {
+	Path string `json:"path"`
+}
+
+type taskRunnerRunMeta struct {
+	ID         string `json:"id"`
+	SourcePath string `json:"source_path"`
+	RunPath    string `json:"run_path"`
+	LogPath    string `json:"log_path"`
+	PID        int    `json:"pid,omitempty"`
+	Status     string `json:"status"`
+	StartedAt  string `json:"started_at"`
+	FinishedAt string `json:"finished_at,omitempty"`
+	Error      string `json:"error,omitempty"`
+}
+
+func (h *Handler) registerTaskRunnerRoutes(mux *http.ServeMux) {
+	mux.HandleFunc("GET /api/task-runner/status", h.handleTaskRunnerStatus)
+	mux.HandleFunc("POST /api/task-runner/tasks/run", h.handleTaskRunnerRun)
+	mux.HandleFunc("GET /api/task-runner/artifact", h.handleTaskRunnerArtifact)
+	mux.HandleFunc("DELETE /api/task-runner/artifact", h.handleTaskRunnerDeleteArtifact)
+}
+
+func (h *Handler) handleTaskRunnerStatus(w http.ResponseWriter, r *http.Request) {
+	ctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)
+	defer cancel()
+
+	cfg := readJSONMap(h.configPath)
+	workspace := configWorkspace(cfg, defaultPicoclawWorkspace)
+	taskDirs := taskRunnerTaskDirs(workspace)
+	artifactDirs := taskRunnerArtifactDirs(workspace)
+	payload := map[string]any{
+		"generated_at":          time.Now().UTC().Format(time.RFC3339),
+		"executor":              taskRunnerExecutor(ctx),
+		"tasks":                 taskRunnerTasks(taskDirs),
+		"runs":                  taskRunnerRuns(ctx),
+		"artifacts":             taskRunnerArtifacts(artifactDirs),
+		"background_operations": cronSummary(filepath.Join(workspace, "cron", "jobs.json")),
+		"paths": map[string]any{
+			"workspace":     workspace,
+			"nano_os_agent": defaultNanoOSAgentRoot,
+			"task_runner":   taskRunnerRoot,
+		},
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(payload)
+}
+
+func (h *Handler) handleTaskRunnerRun(w http.ResponseWriter, r *http.Request) {
+	var req taskRunnerRunRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		http.Error(w, "invalid JSON body", http.StatusBadRequest)
+		return
+	}
+	cfg := readJSONMap(h.configPath)
+	workspace := configWorkspace(cfg, defaultPicoclawWorkspace)
+	taskPath, err := validateTaskRunnerTaskPath(req.Path, taskRunnerTaskDirs(workspace))
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	raw, err := os.ReadFile(taskPath)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	task := analyzeTaskFile(taskPath, raw)
+	if !boolFromAny(task["safe_to_run"], false) {
+		http.Error(w, stringFromAny(task["reason"]), http.StatusBadRequest)
+		return
+	}
+	if meta := fileMeta(defaultNanoOSAgentBinary); !existsMeta(meta) {
+		http.Error(w, "nano-os-agent binary is missing", http.StatusServiceUnavailable)
+		return
+	}
+
+	runID := taskRunnerRunID(taskPath)
+	runTaskDir := filepath.Join(taskRunnerRoot, "tasks")
+	if err := os.MkdirAll(runTaskDir, 0o755); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	runPath := filepath.Join(runTaskDir, runID+".yaml")
+	logPath := filepath.Join(taskRunnerRoot, runID+".log")
+	metaPath := filepath.Join(taskRunnerRoot, runID+".json")
+	if err := os.WriteFile(runPath, raw, 0o644); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	logFile, err := os.OpenFile(logPath, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0o644)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+
+	cmd := exec.Command(defaultNanoOSAgentBinary, "--once", runPath)
+	cmd.Dir = defaultNanoOSAgentRoot
+	cmd.Stdout = logFile
+	cmd.Stderr = logFile
+	if err := cmd.Start(); err != nil {
+		_ = logFile.Close()
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	meta := taskRunnerRunMeta{
+		ID:         runID,
+		SourcePath: taskPath,
+		RunPath:    runPath,
+		LogPath:    logPath,
+		PID:        cmd.Process.Pid,
+		Status:     "running",
+		StartedAt:  time.Now().UTC().Format(time.RFC3339),
+	}
+	writeTaskRunnerRunMeta(metaPath, meta)
+
+	go func() {
+		waitErr := cmd.Wait()
+		_ = logFile.Close()
+		meta.Status = "completed"
+		if waitErr != nil {
+			meta.Status = "failed"
+			meta.Error = waitErr.Error()
+		}
+		meta.FinishedAt = time.Now().UTC().Format(time.RFC3339)
+		writeTaskRunnerRunMeta(metaPath, meta)
+	}()
+
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(meta)
+}
+
+func (h *Handler) handleTaskRunnerArtifact(w http.ResponseWriter, r *http.Request) {
+	path := strings.TrimSpace(r.URL.Query().Get("path"))
+	cfg := readJSONMap(h.configPath)
+	workspace := configWorkspace(cfg, defaultPicoclawWorkspace)
+	clean, err := validateTaskRunnerArtifactPath(path, taskRunnerArtifactDirs(workspace))
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	w.Header().Set("Cache-Control", "no-store")
+	http.ServeFile(w, r, clean)
+}
+
+func (h *Handler) handleTaskRunnerDeleteArtifact(w http.ResponseWriter, r *http.Request) {
+	path := strings.TrimSpace(r.URL.Query().Get("path"))
+	cfg := readJSONMap(h.configPath)
+	workspace := configWorkspace(cfg, defaultPicoclawWorkspace)
+	clean, err := validateTaskRunnerArtifactPath(path, taskRunnerArtifactDirs(workspace))
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	info, err := os.Stat(clean)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	if info.IsDir() {
+		http.Error(w, "artifact delete only supports files", http.StatusBadRequest)
+		return
+	}
+	if err := os.Remove(clean); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(map[string]any{"deleted": true, "path": clean})
+}
+
+func taskRunnerTaskDirs(workspace string) []string {
+	return []string{
+		filepath.Join(defaultNanoOSAgentRoot, "tasks"),
+		filepath.Join(workspace, "tasks"),
+	}
+}
+
+func taskRunnerArtifactDirs(workspace string) []string {
+	return []string{
+		filepath.Join(defaultNanoOSAgentRoot, "artifacts"),
+		filepath.Join(workspace, "artifacts"),
+		filepath.Join(workspace, defaultGoidanichDirectory, "results"),
+		"/tmp/picoclaw_outbox",
+		"/tmp/observations",
+		"/tmp/monitors",
+		taskRunnerRoot,
+	}
+}
+
+func taskRunnerExecutor(ctx context.Context) map[string]any {
+	meta := fileMeta(defaultNanoOSAgentBinary)
+	format := binaryFormat(ctx, defaultNanoOSAgentBinary)
+	runnable := existsMeta(meta) && strings.Contains(strings.ToLower(format), "elf") &&
+		strings.Contains(strings.ToLower(format), "risc-v")
+	return map[string]any{
+		"binary":    meta,
+		"format":    format,
+		"runnable":  runnable,
+		"processes": processMatches(ctx, []string{defaultNanoOSAgentBinary, "nano-os-agent --once"}),
+	}
+}
+
+func binaryFormat(ctx context.Context, path string) string {
+	if raw, err := os.ReadFile(path); err == nil && len(raw) >= 4 && string(raw[:4]) == "\x7fELF" {
+		cmdCtx, cancel := context.WithTimeout(ctx, 500*time.Millisecond)
+		defer cancel()
+		if out, err := exec.CommandContext(cmdCtx, "file", path).Output(); err == nil {
+			return strings.TrimSpace(string(out))
+		}
+		return "ELF executable"
+	}
+	cmdCtx, cancel := context.WithTimeout(ctx, 500*time.Millisecond)
+	defer cancel()
+	if out, err := exec.CommandContext(cmdCtx, "file", path).Output(); err == nil {
+		return strings.TrimSpace(string(out))
+	}
+	return ""
+}
+
+func taskRunnerTasks(dirs []string) map[string]any {
+	var items []map[string]any
+	statusCounts := map[string]int{}
+	for _, dir := range dirs {
+		_ = filepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {
+			if err != nil || d == nil || d.IsDir() {
+				return nil
+			}
+			if !strings.HasSuffix(path, ".yaml") && !strings.HasSuffix(path, ".yml") {
+				return nil
+			}
+			raw, err := os.ReadFile(path)
+			if err != nil {
+				return nil
+			}
+			item := analyzeTaskFile(path, raw)
+			if status := stringFromAny(item["status"]); status != "" {
+				statusCounts[status]++
+			}
+			items = append(items, item)
+			return nil
+		})
+	}
+	sort.Slice(items, func(i, j int) bool {
+		return stringFromAny(items[i]["path"]) < stringFromAny(items[j]["path"])
+	})
+	return map[string]any{"directories": dirs, "count": len(items), "status_counts": statusCounts, "items": items}
+}
+
+func analyzeTaskFile(path string, raw []byte) map[string]any {
+	actions := yamlScalars(raw, "action")
+	skillNames := yamlScalars(raw, "skill_name")
+	status := firstNonEmpty(yamlScalar(raw, "status"), "unknown")
+	unsafeReasons := []string{}
+	for _, action := range actions {
+		switch action {
+		case "shell_cmd", "run_python_code":
+			unsafeReasons = append(unsafeReasons, "raw code/shell task is blocked in web Task Runner")
+		}
+	}
+	if strings.Contains(string(raw), "repeat:") {
+		unsafeReasons = append(unsafeReasons, "repeat/long-running task must be launched from nano-os-agent policy, not the web one-shot runner")
+	}
+	reason := "safe one-shot task"
+	if len(unsafeReasons) > 0 {
+		reason = strings.Join(unsafeReasons, "; ")
+	}
+	return map[string]any{
+		"path":        path,
+		"id":          yamlScalar(raw, "id"),
+		"name":        yamlScalar(raw, "name"),
+		"status":      status,
+		"priority":    yamlScalar(raw, "priority"),
+		"actions":     actions,
+		"skill_names": skillNames,
+		"safe_to_run": len(unsafeReasons) == 0,
+		"reason":      reason,
+		"file":        fileMeta(path),
+	}
+}
+
+func yamlScalars(raw []byte, key string) []string {
+	seen := map[string]struct{}{}
+	var out []string
+	for _, line := range strings.Split(string(raw), "\n") {
+		k, v, ok := splitYAMLScalar(strings.TrimSpace(strings.TrimPrefix(line, "- ")))
+		if !ok || k != key || v == "" {
+			continue
+		}
+		if _, exists := seen[v]; exists {
+			continue
+		}
+		seen[v] = struct{}{}
+		out = append(out, v)
+	}
+	return out
+}
+
+func taskRunnerRuns(ctx context.Context) map[string]any {
+	entries, err := os.ReadDir(taskRunnerRoot)
+	if err != nil {
+		return map[string]any{"path": taskRunnerRoot, "count": 0, "items": []map[string]any{}, "error": err.Error()}
+	}
+	var items []map[string]any
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".json") {
+			continue
+		}
+		path := filepath.Join(taskRunnerRoot, entry.Name())
+		var meta taskRunnerRunMeta
+		if raw, err := os.ReadFile(path); err == nil {
+			_ = json.Unmarshal(raw, &meta)
+		}
+		item := map[string]any{
+			"id":          meta.ID,
+			"source_path": meta.SourcePath,
+			"run_path":    meta.RunPath,
+			"log_path":    meta.LogPath,
+			"pid":         meta.PID,
+			"status":      liveRunStatus(ctx, meta),
+			"started_at":  meta.StartedAt,
+			"finished_at": meta.FinishedAt,
+			"error":       meta.Error,
+			"log_tail":    tailLines(meta.LogPath, 40),
+			"file":        fileMeta(path),
+		}
+		items = append(items, item)
+	}
+	sort.Slice(items, func(i, j int) bool {
+		return floatFromAny(asMapForTaskRunner(items[i]["file"])["mtime_unix"]) >
+			floatFromAny(asMapForTaskRunner(items[j]["file"])["mtime_unix"])
+	})
+	if len(items) > 12 {
+		items = items[:12]
+	}
+	return map[string]any{"path": taskRunnerRoot, "count": len(items), "items": items}
+}
+
+func liveRunStatus(ctx context.Context, meta taskRunnerRunMeta) string {
+	if meta.Status != "running" || meta.PID <= 0 {
+		return meta.Status
+	}
+	for _, proc := range processMatches(ctx, []string{fmt.Sprintf("%d", meta.PID)}) {
+		if stringFromAny(proc["pid"]) == fmt.Sprintf("%d", meta.PID) {
+			return "running"
+		}
+	}
+	return "finished"
+}
+
+func taskRunnerArtifacts(dirs []string) map[string]any {
+	allowedExt := map[string]bool{
+		".png": true, ".jpg": true, ".jpeg": true, ".webp": true, ".svg": true,
+		".json": true, ".jsonl": true, ".md": true, ".txt": true, ".log": true,
+	}
+	var items []map[string]any
+	for _, dir := range dirs {
+		_ = filepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {
+			if err != nil || d == nil || d.IsDir() {
+				return nil
+			}
+			ext := strings.ToLower(filepath.Ext(path))
+			if !allowedExt[ext] {
+				return nil
+			}
+			item := fileMeta(path)
+			item["name"] = filepath.Base(path)
+			item["extension"] = ext
+			item["image"] = ext == ".png" || ext == ".jpg" || ext == ".jpeg" || ext == ".webp" || ext == ".svg"
+			item["url"] = "/api/task-runner/artifact?path=" + url.QueryEscape(path)
+			items = append(items, item)
+			return nil
+		})
+	}
+	sort.Slice(items, func(i, j int) bool {
+		return floatFromAny(items[i]["mtime_unix"]) > floatFromAny(items[j]["mtime_unix"])
+	})
+	if len(items) > 40 {
+		items = items[:40]
+	}
+	return map[string]any{"directories": dirs, "count": len(items), "items": items}
+}
+
+func validateTaskRunnerTaskPath(path string, dirs []string) (string, error) {
+	clean, err := filepath.Abs(filepath.Clean(strings.TrimSpace(path)))
+	if err != nil || clean == "" {
+		return "", fmt.Errorf("invalid task path")
+	}
+	ext := strings.ToLower(filepath.Ext(clean))
+	if ext != ".yaml" && ext != ".yml" {
+		return "", fmt.Errorf("task path must be YAML")
+	}
+	if !pathUnderAny(clean, dirs) {
+		return "", fmt.Errorf("task path is outside allowed task directories")
+	}
+	return clean, nil
+}
+
+func validateTaskRunnerArtifactPath(path string, dirs []string) (string, error) {
+	clean, err := filepath.Abs(filepath.Clean(strings.TrimSpace(path)))
+	if err != nil || clean == "" {
+		return "", fmt.Errorf("invalid artifact path")
+	}
+	ext := strings.ToLower(filepath.Ext(clean))
+	switch ext {
+	case ".png", ".jpg", ".jpeg", ".webp", ".svg", ".json", ".jsonl", ".md", ".txt", ".log":
+	default:
+		return "", fmt.Errorf("artifact extension is not served")
+	}
+	if !pathUnderAny(clean, dirs) {
+		return "", fmt.Errorf("artifact path is outside allowed artifact directories")
+	}
+	return clean, nil
+}
+
+func pathUnderAny(path string, roots []string) bool {
+	clean := filepath.Clean(path)
+	for _, root := range roots {
+		rootAbs, err := filepath.Abs(filepath.Clean(root))
+		if err != nil {
+			continue
+		}
+		rel, err := filepath.Rel(rootAbs, clean)
+		if err == nil && rel != "." && !strings.HasPrefix(rel, "..") {
+			return true
+		}
+		if clean == rootAbs {
+			return true
+		}
+	}
+	return false
+}
+
+func taskRunnerRunID(taskPath string) string {
+	base := strings.TrimSuffix(filepath.Base(taskPath), filepath.Ext(taskPath))
+	slug := regexp.MustCompile(`[^a-zA-Z0-9_.-]+`).ReplaceAllString(base, "-")
+	slug = strings.Trim(slug, "-_.")
+	if slug == "" {
+		slug = "task"
+	}
+	return time.Now().UTC().Format("20060102T150405") + "_" + slug
+}
+
+func writeTaskRunnerRunMeta(path string, meta taskRunnerRunMeta) {
+	_ = os.MkdirAll(filepath.Dir(path), 0o755)
+	raw, err := json.MarshalIndent(meta, "", "  ")
+	if err != nil {
+		return
+	}
+	_ = os.WriteFile(path, raw, 0o644)
+}
+
+func asMapForTaskRunner(value any) map[string]any {
+	if m, ok := value.(map[string]any); ok {
+		return m
+	}
+	return map[string]any{}
+}
