+func httpJSON(ctx context.Context, url string) map[string]any {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		return map[string]any{"ok": false, "url": url, "error": err.Error()}
+	}
+	client := http.Client{Timeout: 900 * time.Millisecond}
+	resp, err := client.Do(req)
+	if err != nil {
+		return map[string]any{"ok": false, "url": url, "error": err.Error()}
+	}
+	defer resp.Body.Close()
+	var body map[string]any
+	if err := json.NewDecoder(resp.Body).Decode(&body); err != nil {
+		return map[string]any{"ok": false, "url": url, "status_code": resp.StatusCode, "error": err.Error()}
+	}
+	body["ok"] = resp.StatusCode >= 200 && resp.StatusCode < 300
+	body["status_code"] = resp.StatusCode
+	body["url"] = url
+	return body
+}
+
+func processMatches(ctx context.Context, needles []string) []map[string]any {
+	cmd := exec.CommandContext(ctx, "ps", "w")
+	out, err := cmd.Output()
+	if err != nil {
+		return []map[string]any{{"error": err.Error()}}
+	}
+	needleSet := make([]string, 0, len(needles))
+	for _, needle := range needles {
+		needleSet = append(needleSet, strings.ToLower(needle))
+	}
+	var matches []map[string]any
+	for _, line := range strings.Split(string(out), "\n") {
+		lower := strings.ToLower(line)
+		if strings.Contains(lower, "grep") {
+			continue
+		}
+		for _, needle := range needleSet {
+			if !strings.Contains(lower, needle) {
+				continue
+			}
+			fields := strings.Fields(line)
+			if len(fields) == 0 {
+				continue
+			}
+			matches = append(matches, map[string]any{"pid": fields[0], "command": strings.TrimSpace(line)})
+			break
+		}
+	}
+	return matches
+}
