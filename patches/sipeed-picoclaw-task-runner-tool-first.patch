+          <StatLine label="Jobs" value={scheduler.count} />
+          <StatLine label="Enabled" value={scheduler.enabled} />
+          <CompactList items={asArray(scheduler.jobs)} />
+        </StatusCard>
+      </div>
+      {asArray(telegram.recent_errors).length > 0 ? (
+        <Card size="sm" className="rounded-lg">
+          <CardHeader>
+            <CardTitle>Recent Telegram errors</CardTitle>
+          </CardHeader>
+          <CardContent>
+            <pre className="bg-muted max-h-36 overflow-auto rounded-md p-3 text-xs whitespace-pre-wrap">
+              {asArray(telegram.recent_errors).join("\n")}
+            </pre>
+          </CardContent>
+        </Card>
+      ) : null}
+    </section>
+  )
+}
+
+function NanoSection({ nano }: { nano: RuntimeMap }) {
+  const hardware = asMap(nano.board_hardware_status)
+  const tasks = asMap(nano.task_queue)
+  const running = asMap(nano.running_experiments)
+  const skillFlow = asMap(nano.skill_validation_promote_flow)
+  const artifacts = asMap(nano.artifacts)
+  const counts = asMap(artifacts.counts)
+  const skillInventory = asMap(skillFlow.skills)
+
+  return (
+    <section className="space-y-3">
+      <h3 className="text-lg font-semibold">Platform: nano-os-agent</h3>
+      <div className="grid gap-4 xl:grid-cols-4">
+        <StatusCard title="Board hardware status">
+          <StatLine
+            label="/dev/video*"
+            value={asArray(hardware.dev_video).length}
+          />
+          <StatLine
+            label="I2C buses"
+            value={asArray(hardware.i2c_buses).length}
+          />
+          <StatLine label="PWM nodes" value={asArray(hardware.pwm).length} />
+          <StatLine
+            label="Thermal zones"
+            value={asArray(hardware.thermal_zones).length}
+          />
+        </StatusCard>
+
+        <StatusCard title="Task queue">
+          <StatLine label="Task files" value={tasks.count} />
+          <CompactList items={asArray(tasks.items)} />
+        </StatusCard>
+
+        <StatusCard title="Experiments / journals">
+          <StatLine
+            label="Running processes"
+            value={asArray(running.processes).length}
+          />
+          <CompactList items={asArray(running.journals)} />
+        </StatusCard>
+
+        <StatusCard title="Skill validation / artifacts">
+          <StatLine label="nano skills" value={skillInventory.count} />
+          <StatLine label="Images" value={counts.images} />
+          <StatLine label="Audio" value={counts.audio} />
+          <StatLine label="Plots" value={counts.plots} />
+          <StatLine label="JSON" value={counts.json} />
+        </StatusCard>
+      </div>
+    </section>
+  )
+}
+
+function DiseaseCard({
+  title,
+  disease,
+}: {
+  title: string
+  disease: RuntimeMap
+}) {
+  const state = asMap(disease.state)
+  const plot = asMap(disease.plot)
+  const report = asMap(disease.report)
+  const freshness = asMap(disease.freshness)
+
+  return (
+    <StatusCard title={title}>
+      <StatLine label="Updated" value={disease.updated_at} />
+      <StatLine label="Forecast rows" value={disease.forecast_rows} />
+      <StatLine
+        label="State JSON"
+        value={exists(state) ? "present" : "missing"}
+      />
+      <StatLine label="Report" value={exists(report) ? "present" : "missing"} />
+      <StatLine label="Plot PNG" value={exists(plot) ? "present" : "missing"} />
+      <StatLine
+        label="Forecast current"
+        value={boolValue(freshness.forecast_current) ? "yes" : "no"}
+      />
+      <StatLine
+        label="Prediction current"
+        value={boolValue(freshness.prediction_ok) ? "yes" : "no"}
+      />
+    </StatusCard>
+  )
+}
+
+function VineyardSection({ vineyard }: { vineyard: RuntimeMap }) {
+  const app = asMap(vineyard.app)
+  const fields = asMap(vineyard.fields_from_yaml)
+  const reports = asMap(vineyard.disease_reports)
+  const supabase = asMap(vineyard.supabase_sync_state)
+  const env = asMap(supabase.env)
+  const envKeys = asMap(env.keys)
+  const neighbours = asMap(supabase.neighbours)
+  const feedback = asMap(vineyard.farmer_feedback_product_catalog)
+  const treatments = asMap(vineyard.treatment_history)
+
+  return (
+    <section className="space-y-3">
+      <div className="flex items-center justify-between">
+        <h3 className="text-lg font-semibold">Apps</h3>
+        <Badge variant="outline">Extensible app slots</Badge>
+      </div>
+      <div className="grid gap-4 xl:grid-cols-4">
+        <StatusCard
+          title="Vineyard Guard"
+          description="Private goidanich app, active only when the repo/runtime is present."
+        >
+          <StatLine
+            label="Status"
+            value={app.available === true ? "active" : "not installed"}
+          />
+          <StatLine label="Runtime" value={app.runtime} />
+          <StatLine label="Repo path" value={app.repo_path} />
+          <StatLine
+            label="Configured fields"
+            value={asArray(fields.fields).length}
+          />
+          <CompactList items={asArray(fields.fields)} />
+        </StatusCard>
+
+        <DiseaseCard
+          title="Downy disease report"
+          disease={asMap(reports.downy_mildew)}
+        />
+
+        <DiseaseCard
+          title="Powdery disease report"
+          disease={asMap(reports.powdery_mildew)}
+        />
+
+        <StatusCard title="Supabase / feedback / treatments">
+          <StatLine
+            label="Supabase URL"
+            value={boolValue(envKeys.SUPABASE_URL) ? "configured" : "missing"}
+          />
+          <StatLine
+            label="Publishable key"
+            value={
+              boolValue(envKeys.SUPABASE_PUBLISHABLE_KEY) ||
+              boolValue(envKeys.SUPABASE_ANON_KEY)
+                ? "configured"
+                : "missing"
+            }
+          />
+          <StatLine label="Neighbours" value={neighbours.count} />
+          <StatLine
+            label="Feedback DB"
+            value={feedback.available === true ? "readable" : "not readable"}
+          />
+          <StatLine
+            label="Product catalog"
+            value={
+              feedback.product_catalog_count ??
+              feedback.products_count ??
+              "not detected"
+            }
+          />
+          <StatLine
+            label="Recent treatments"
+            value={asArray(treatments.recent).length}
+          />
+        </StatusCard>
+      </div>
+    </section>
+  )
+}
+
+export function VineyardGuardPage() {
+  const { data, error, isFetching, refetch } = useQuery({
+    queryKey: ["vineyard-guard-runtime-status"],
+    queryFn: getVineyardGuardRuntimeStatus,
+    refetchInterval: 30000,
+  })
+
+  return (
+    <div className="flex h-full flex-col">
+      <PageHeader
+        title="Board Runtime"
+        titleExtra={
+          data?.generated_at ? (
+            <Badge variant="outline">
+              Snapshot {new Date(data.generated_at).toLocaleString()}
+            </Badge>
+          ) : null
+        }
+      >
+        <Button
+          variant="outline"
+          size="sm"
+          onClick={() => void refetch()}
+          disabled={isFetching}
+        >
+          <IconRefresh
+            className={isFetching ? "size-4 animate-spin" : "size-4"}
+          />
+          Refresh
+        </Button>
+      </PageHeader>
+
+      <main className="flex-1 overflow-auto px-6 py-6">
+        <div className="max-w-7xl space-y-8">
+          {error ? (
+            <Card className="rounded-lg">
+              <CardHeader>
+                <CardTitle>Runtime snapshot failed</CardTitle>
+                <CardDescription>
+                  {error instanceof Error ? error.message : "Unknown error"}
+                </CardDescription>
+              </CardHeader>
+            </Card>
+          ) : null}
+
+          {!data && !error ? (
+            <div className="text-muted-foreground text-sm">
+              Loading runtime snapshot...
+            </div>
+          ) : null}
+
+          {data ? (
+            <>
+              <GatewaySection
+                gateway={asMap(
+                  asMap(data.platform).picoclaw_gateway ?? data.gateway,
+                )}
+              />
+              <NanoSection
+                nano={asMap(
+                  asMap(data.platform).nano_os_agent ?? data.nano_os_agent,
+                )}
+              />
+              <VineyardSection
+                vineyard={asMap(
+                  asMap(data.apps).vineyard_guard ?? data.vineyard_guard,
+                )}
+              />
+            </>
+          ) : null}
+        </div>
+      </main>
+    </div>
+  )
+}
