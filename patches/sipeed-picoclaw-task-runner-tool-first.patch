+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const (
+	defaultPicoclawHome       = "/root/.picoclaw"
+	defaultPicoclawWorkspace  = "/root/.picoclaw/workspace"
+	defaultNanoOSAgentRoot    = "/root/nano-os-agent"
+	defaultGatewayReadyURL    = "http://127.0.0.1:18790/ready"
+	defaultGatewayHealthURL   = "http://127.0.0.1:18790/health"
+	defaultGatewayLogPath     = "/tmp/picoclaw_gateway.log"
+	defaultGoidanichDirectory = "goidanich"
+)
+
+// registerVineyardGuardRoutes binds the read-only board overview endpoint.
+func (h *Handler) registerVineyardGuardRoutes(mux *http.ServeMux) {
+	mux.HandleFunc("GET /api/runtime/status", h.handleVineyardGuardStatus)
+	mux.HandleFunc("GET /api/vineyard-guard/status", h.handleVineyardGuardStatus)
+}
+
+func (h *Handler) handleVineyardGuardStatus(w http.ResponseWriter, r *http.Request) {
+	ctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)
+	defer cancel()
+
+	cfg := readJSONMap(h.configPath)
+	picoclawHome := filepath.Dir(h.configPath)
+	if picoclawHome == "." || picoclawHome == "" {
+		picoclawHome = defaultPicoclawHome
+	}
+	workspace := configWorkspace(cfg, defaultPicoclawWorkspace)
+	goidanichPath := filepath.Join(workspace, defaultGoidanichDirectory)
+
+	gateway := collectGatewayOverview(ctx, h.configPath, cfg, workspace)
+	nano := collectNanoOSAgentOverview(ctx, workspace)
+	vineyard := collectVineyardGuardOverview(ctx, goidanichPath)
+
+	payload := map[string]any{
+		"generated_at": time.Now().UTC().Format(time.RFC3339),
+		"paths": map[string]any{
+			"config":        h.configPath,
+			"picoclaw_home": picoclawHome,
+			"workspace":     workspace,
+			"goidanich":     goidanichPath,
+			"nano_os_agent": defaultNanoOSAgentRoot,
+		},
+		"platform": map[string]any{
+			"picoclaw_gateway": gateway,
+			"nano_os_agent":    nano,
+		},
+		"apps": map[string]any{
+			"vineyard_guard": vineyard,
