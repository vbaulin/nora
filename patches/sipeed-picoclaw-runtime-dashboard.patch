+import { IconRefresh } from "@tabler/icons-react"
+import { useQuery } from "@tanstack/react-query"
+import type { ReactNode } from "react"
+
+import {
+  type RuntimeMap,
+  getVineyardGuardRuntimeStatus,
+} from "@/api/vineyard-guard"
+import { PageHeader } from "@/components/page-header"
+import { Badge } from "@/components/ui/badge"
+import { Button } from "@/components/ui/button"
+import {
+  Card,
+  CardContent,
+  CardDescription,
+  CardHeader,
+  CardTitle,
+} from "@/components/ui/card"
+
+function asMap(value: unknown): RuntimeMap {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as RuntimeMap)
+    : {}
+}
+
+function asArray(value: unknown): unknown[] {
+  return Array.isArray(value) ? value : []
+}
+
+function asString(value: unknown, fallback = "not available"): string {
+  if (typeof value === "string" && value.trim()) return value
+  if (typeof value === "number" || typeof value === "boolean") {
+    return String(value)
+  }
+  return fallback
+}
+
+function boolValue(value: unknown): boolean {
+  return value === true || value === "true" || value === "ok"
+}
+
+function exists(value: unknown): boolean {
+  return boolValue(asMap(value).exists)
+}
+
+function StatusBadge({ ok, label }: { ok: boolean; label?: string }) {
+  return (
+    <Badge variant={ok ? "secondary" : "destructive"}>
+      {label ?? (ok ? "ok" : "attention")}
+    </Badge>
+  )
+}
+
+function StatLine({ label, value }: { label: string; value: unknown }) {
+  return (
+    <div className="border-border/50 flex min-h-6 items-start justify-between gap-4 border-b py-1.5 last:border-b-0">
+      <span className="text-muted-foreground">{label}</span>
+      <span className="max-w-[65%] text-right font-medium break-words">
+        {asString(value)}
+      </span>
+    </div>
+  )
+}
+
+function CompactList({
+  items,
+  empty = "No entries detected",
+}: {
+  items: unknown[]
+  empty?: string
+}) {
+  if (items.length === 0) {
+    return <div className="text-muted-foreground text-sm">{empty}</div>
+  }
+  return (
+    <div className="space-y-1.5">
+      {items.slice(0, 8).map((item, index) => {
+        const map = asMap(item)
+        const title =
+          asString(map.name, "") ||
+          asString(map.id, "") ||
+          asString(map.directory, "") ||
+          asString(map.path, `item ${index + 1}`)
+        const detail =
+          asString(map.schedule, "") ||
+          asString(map.status, "") ||
+          asString(map.type, "") ||
+          asString(map.mtime, "")
+        return (
+          <div
+            key={`${title}-${index}`}
+            className="bg-muted/40 flex items-start justify-between gap-3 rounded-md px-2 py-1.5 text-sm"
+          >
+            <span className="min-w-0 font-medium break-words">{title}</span>
+            {detail ? (
+              <span className="text-muted-foreground max-w-[45%] text-right text-xs break-words">
+                {detail}
+              </span>
+            ) : null}
+          </div>
+        )
+      })}
+      {items.length > 8 ? (
+        <div className="text-muted-foreground text-xs">
+          +{items.length - 8} more
+        </div>
+      ) : null}
+    </div>
+  )
+}
+
+function StatusCard({
+  title,
+  description,
+  children,
