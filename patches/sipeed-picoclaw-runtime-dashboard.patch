+func collectNanoOSAgentOverview(ctx context.Context, workspace string) map[string]any {
+	taskDirs := []string{
+		filepath.Join(defaultNanoOSAgentRoot, "tasks"),
+		filepath.Join(workspace, "tasks"),
+	}
+	journalPaths := []string{
+		filepath.Join(defaultNanoOSAgentRoot, "experiments.jsonl"),
+		filepath.Join(workspace, "experiments.jsonl"),
+	}
+	return map[string]any{
+		"board_hardware_status": hardwareReadOnlyInventory(),
+		"task_queue":            taskQueueSummary(taskDirs),
+		"running_experiments": map[string]any{
+			"processes": processMatches(ctx, []string{"nano-os-agent", "nano_os_agent"}),
+			"journals":  journalSummary(journalPaths),
+		},
+		"skill_validation_promote_flow": map[string]any{
+			"root":            fileMeta(defaultNanoOSAgentRoot),
+			"skills":          skillInventory(filepath.Join(defaultNanoOSAgentRoot, "skills")),
+			"validation_hits": taskKeywordHits(taskDirs, []string{"validate_skill", "promote_skill", "validation", "promote"}),
+		},
+		"hardware_capability_map": hardwareReadOnlyInventory(),
+		"experiment_journal":      journalSummary(journalPaths),
+		"artifacts": artifactSummary([]string{
+			filepath.Join(defaultNanoOSAgentRoot, "artifacts"),
+			filepath.Join(workspace, "artifacts"),
+			filepath.Join(workspace, defaultGoidanichDirectory, "results"),
+			"/tmp/observations",
+			"/tmp/monitors",
+		}),
