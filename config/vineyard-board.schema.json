{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nano-os-agent/vineyard-board.schema.json",
  "title": "Vineyard Guard board manifest",
  "type": "object",
  "required": ["schema", "board", "fields"],
  "properties": {
    "schema": {
      "const": "vineyard_board_manifest_v1"
    },
    "board": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "preferred_language": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "supabase_project_ref": {
          "type": "string"
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "coordinates", "variety"],
        "anyOf": [
          {
            "required": ["planting_year"]
          },
          {
            "required": ["vine_age_years"]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "coordinates": {
            "type": "object",
            "required": ["latitude", "longitude"],
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          },
          "variety": {
            "type": "string",
            "minLength": 1
          },
          "planting_year": {
            "type": "integer",
            "minimum": 1800
          },
          "vine_age_years": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "disease_context": {
            "type": "object",
            "properties": {
              "black_rot_inoculum_status": {
                "type": "string",
                "enum": ["present", "not_reported", "unknown"]
              },
              "black_rot_evidence_source": {
                "type": "string"
              },
              "black_rot_evidence_note": {
                "type": "string"
              },
              "secondary_bunch_rot_status": {
                "type": "string",
                "enum": ["reported_concern", "confirmed", "not_reported", "unknown"]
              },
              "secondary_bunch_rot_primary_concern": {
                "type": "string"
              },
              "secondary_bunch_rot_reported_taxa": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "secondary_bunch_rot_evidence_source": {
                "type": "string"
              },
              "secondary_bunch_rot_evidence_note": {
                "type": "string"
              }
            }
          },
          "sigpac": {
            "type": "object",
            "properties": {
              "expected_use_code": {
                "type": "string"
              },
              "reference": {
                "type": "object"
              },
              "properties": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
