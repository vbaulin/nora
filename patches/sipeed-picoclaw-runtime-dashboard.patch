+func telegramSummary(picoclawHome string, workspace string, cfg map[string]any) map[string]any {
+	active := false
+	for _, channel := range activeChannelsFromLog(defaultGatewayLogPath) {
+		if channel == "telegram" {
+			active = true
+			break
+		}
+	}
+	tokenEnv := envKeySummary(filepath.Join(picoclawHome, "telegram.env"), []string{"TELEGRAM_BOT_TOKEN", "PICOCLAW_CHANNELS_TELEGRAM_TOKEN"})
+	tokenKeys, _ := tokenEnv["keys"].(map[string]bool)
+	hasToken := tokenKeys["TELEGRAM_BOT_TOKEN"] || tokenKeys["PICOCLAW_CHANNELS_TELEGRAM_TOKEN"]
+	return map[string]any{
+		"configured":           telegramConfigured(cfg) || active || hasToken,
+		"active":               active,
+		"token_env":            tokenEnv,
+		"recent_errors":        logLinesContaining(defaultGatewayLogPath, []string{"telego", "telegram"}, 12),
+		"outbox":               directorySummary("/tmp/picoclaw_outbox"),
+		"scheduled_alert_jobs": cronJobsMatching(filepath.Join(workspace, "cron", "jobs.json"), []string{"telegram", "risk_only", "picoclaw_telegram"}),
+	}
+}
+
+func telegramConfigured(cfg map[string]any) bool {
+	for _, item := range configuredChannels(cfg) {
+		name := strings.ToLower(firstNonEmpty(stringFromAny(item["name"]), stringFromAny(item["type"])))
+		if strings.Contains(name, "telegram") {
+			return boolFromAny(item["enabled"], true)
+		}
+	}
+	if channels, ok := cfg["channels"].(map[string]any); ok {
+		if _, ok := channels["telegram"]; ok {
+			return true
+		}
+	}
+	return false
+}
