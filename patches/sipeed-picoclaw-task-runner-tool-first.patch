+func cronJobsMatching(path string, terms []string) []map[string]any {
+	summary := cronSummary(path)
+	raw, _ := summary["jobs"].([]map[string]any)
+	if raw == nil {
+		if anyJobs, ok := summary["jobs"].([]any); ok {
+			for _, item := range anyJobs {
+				if m, ok := item.(map[string]any); ok {
+					raw = append(raw, m)
+				}
+			}
+		}
+	}
+	var hits []map[string]any
+	for _, job := range raw {
+		blob := strings.ToLower(stringFromAny(job["id"]) + " " + stringFromAny(job["name"]) + " " + mapJSON(job))
+		for _, term := range terms {
+			if strings.Contains(blob, strings.ToLower(term)) {
+				hits = append(hits, job)
+				break
+			}
+		}
+	}
+	return hits
+}
